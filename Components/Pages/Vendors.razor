@page "/vendors"
@inject InventoryService Inventory
@inject BusyIndicatorService Busy
@inject ToastService Toasts
@inject ILogger<Vendors> Logger

<PageTitle>Vendor master | Stockroom</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">MASTER DATA</p>
        <h1>Vendor master<span class="heading-period">.</span></h1>
        <p class="page-subtitle">Keep supplier details up to date for incoming receipts.</p>
    </div>
    <button type="button" class="button button-primary" @onclick="AddVendorAsync">+ Add vendor</button>
</div>

<AlertBanner Type="danger" Message="@errorMessage" OnDismiss="DismissError" />

<section class="inventory-panel master-panel">
    <div class="panel-heading">
        <div>
            <div class="panel-title-row"><span class="panel-icon" aria-hidden="true">▦</span><h2>Vendors</h2></div>
            <p class="panel-subtitle">Click a cell to edit. Changes save when you leave the cell.</p>
        </div>
        <div class="table-tools">
            <span class="grid-row-count">@vendors.Count rows</span>
            <span class="edit-hint">✎ &nbsp; CELL EDITING</span>
        </div>
    </div>
    <GridToolbar OnAdd="AddVendorAsync"
                 OnInsert="InsertVendorAsync"
                 OnDelete="DeleteSelectedVendor"
                 OnReset="ResetGridAsync"
                 CanDelete="@(selectedDataItem is Vendor)" />
    <div class="grid-container">
        <DxGrid @ref="grid"
                Data="@vendors"
                KeyFieldName="@nameof(Vendor.Id)"
                SelectionMode="GridSelectionMode.Single"
                @bind-SelectedDataItem="selectedDataItem"
                EditMode="GridEditMode.EditCell"
                @bind-EditNewRowPosition="editNewRowPosition"
                CustomizeEditModel="CustomizeEditModel"
                EditModelSaving="SaveEditAsync"
                PageSize="12"
                PageSizeSelectorVisible="true"
                PageSizeSelectorItems="@(new int[] { 12, 25, 50 })"
                @bind-PageIndex="pageIndex"
                ShowFilterRow="true"
                CssClass="inventory-grid">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(Vendor.Code)" Caption="Vendor code" Width="140px" />
                <DxGridDataColumn FieldName="@nameof(Vendor.Name)" Caption="Vendor" MinWidth="180" />
                <DxGridDataColumn FieldName="@nameof(Vendor.ContactName)" Caption="Contact" Width="155px" />
                <DxGridDataColumn FieldName="@nameof(Vendor.Phone)" Caption="Phone" Width="150px" />
                <DxGridDataColumn FieldName="@nameof(Vendor.Email)" Caption="Email" MinWidth="210" />
                <DxGridDataColumn FieldName="@nameof(Vendor.Address)" Caption="Address" MinWidth="180" />
                <DxGridDataColumn FieldName="@nameof(Vendor.IsActive)" Caption="Active" Width="90px" />
            </Columns>
        </DxGrid>
        @if (vendors.Count == 0 && errorMessage is null)
        {
            <div class="empty-state"><strong>No vendors yet</strong><span>Add a vendor to use it on receipts.</span></div>
        }
    </div>
</section>

@code {
    private DxGrid? grid;
    private List<Vendor> vendors = [];
    private object? selectedDataItem;
    private GridEditNewRowPosition editNewRowPosition = GridEditNewRowPosition.Bottom;
    private int pageIndex;
    private Vendor? vendorToDelete;
    private bool confirmDeleteVisible;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Busy.SetBusy(true);
        try
        {
            await Inventory.InitializeAsync();
            vendors = (await Inventory.GetVendorsAsync()).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load the vendor master.");
            errorMessage = "Could not load vendors from SQL Server LocalDB.";
        }
        finally
        {
            Busy.SetBusy(false);
        }
    }

    private async Task AddVendorAsync()
    {
        errorMessage = null;
        await StartNewRowAsync(GridEditNewRowPosition.Bottom);
    }

    private async Task InsertVendorAsync()
    {
        errorMessage = null;
        await StartNewRowAsync(GridEditNewRowPosition.Top);
    }

    private async Task StartNewRowAsync(GridEditNewRowPosition position)
    {
        if (grid is null)
            return;

        editNewRowPosition = position;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await grid.StartEditNewRowAsync(nameof(Vendor.Name));
    }

    private void DeleteSelectedVendor()
    {
        if (selectedDataItem is Vendor vendor)
        {
            vendorToDelete = vendor;
            confirmDeleteVisible = true;
        }
    }

    private Task ResetGridAsync()
    {
        selectedDataItem = null;
        if (grid is not null)
        {
            grid.ClearFilter();
            grid.ClearSort();
            pageIndex = 0;
        }
        return Task.CompletedTask;
    }

    private Task CancelDeleteAsync()
    {
        confirmDeleteVisible = false;
        vendorToDelete = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (vendorToDelete is null)
            return;

        var vendor = vendorToDelete;
        Busy.SetBusy(true);
        errorMessage = null;
        try
        {
            await Inventory.DeleteVendorAsync(vendor.Id);
            vendors = (await Inventory.GetVendorsAsync()).ToList();
            selectedDataItem = null;
            Toasts.Show("Vendor removed.", ToastKind.Info);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to delete vendor {VendorId}.", vendor.Id);
            errorMessage = "The vendor could not be deleted. Check the database connection and try again.";
        }
        finally
        {
            confirmDeleteVisible = false;
            vendorToDelete = null;
            Busy.SetBusy(false);
        }
    }

    private void CustomizeEditModel(GridCustomizeEditModelEventArgs args)
    {
        if (args.IsNew)
        {
            var vendor = (Vendor)args.EditModel;
            vendor.Code = $"VEN-{Guid.NewGuid():N}"[..10].ToUpperInvariant();
            vendor.Name = "New vendor";
            vendor.IsActive = true;
        }
    }

    private async Task SaveEditAsync(GridEditModelSavingEventArgs args)
    {
        var vendor = (Vendor)args.EditModel;
        Busy.SetBusy(true);
        errorMessage = null;
        try
        {
            await Inventory.SaveVendorAsync(vendor);
            vendors = (await Inventory.GetVendorsAsync()).ToList();
            args.Reload = true;
            Toasts.Show(args.IsNew ? "Vendor added." : "Vendor updated.");
        }
        catch (InvalidOperationException exception)
        {
            args.Cancel = true;
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            args.Cancel = true;
            Logger.LogError(exception, "Unable to save vendor {VendorCode}.", vendor.Code);
            errorMessage = "The vendor could not be saved. Check the vendor code and database connection.";
        }
        finally
        {
            Busy.SetBusy(false);
        }
    }

    private void DismissError() => errorMessage = null;
}

<ConfirmDialog Visible="@confirmDeleteVisible"
               Title="Delete vendor?"
               Message="@($"Delete {vendorToDelete?.Name ?? "this vendor"}? This action cannot be undone.")"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />
