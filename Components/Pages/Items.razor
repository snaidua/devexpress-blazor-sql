@page "/items"
@inject InventoryService Inventory
@inject BusyIndicatorService Busy
@inject ToastService Toasts
@inject ILogger<Items> Logger

<PageTitle>Item master | Stockroom</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">MASTER DATA</p>
        <h1>Item master<span class="heading-period">.</span></h1>
        <p class="page-subtitle">Maintain item details. On-hand stock is updated by posted transactions.</p>
    </div>
</div>

<AlertBanner Type="danger" Message="@errorMessage" OnDismiss="DismissError" />

<section class="inventory-panel master-panel">
    <div class="panel-heading item-grid-header">
        <GridToolbar OnAdd="AddItemAsync"
                     OnInsert="InsertItemAsync"
                     OnDelete="DeleteSelectedItems"
                     OnReset="ResetGridAsync"
                     CanDelete="@selectedDataItems.Any()"
                     IconOnly="true"
                     InHeader="true" />
        <div class="item-grid-title">
            <div class="panel-title-row"><span class="panel-icon" aria-hidden="true">▦</span><h2>Items</h2><span class="count-badge">@FilteredItems.Count</span></div>
        </div>
        <div class="item-grid-filters">
            <select class="select-control" aria-label="Filter by column" @bind="selectedFilterColumn">
                <option value="All">All columns</option>
                <option value="@nameof(Product.Sku)">SKU</option>
                <option value="@nameof(Product.Name)">Item name</option>
                <option value="@nameof(Product.Category)">Category</option>
                <option value="@nameof(Product.Quantity)">On hand</option>
                <option value="@nameof(Product.UnitPrice)">Unit cost</option>
                <option value="@nameof(Product.ReorderLevel)">Reorder level</option>
            </select>
            <input class="column-filter-input"
                   type="search"
                   placeholder="Filter items..."
                   aria-label="Filter items by selected column"
                   @bind="columnFilterText"
                   @bind:event="oninput" />
        </div>
    </div>
    <div class="grid-container">
        <DxGrid @ref="grid"
                Data="@FilteredItems"
                KeyFieldName="@nameof(Product.Id)"
                SelectionMode="GridSelectionMode.Multiple"
                @bind-SelectedDataItems="selectedDataItems"
                EditMode="GridEditMode.EditCell"
                @bind-EditNewRowPosition="editNewRowPosition"
                CustomizeEditModel="CustomizeEditModel"
                EditModelSaving="SaveEditAsync"
                PageSize="12"
                PageSizeSelectorVisible="true"
                PageSizeSelectorItems="@(new int[] { 12, 25, 50 })"
                @bind-PageIndex="pageIndex"
                ShowFilterRow="true"
                CssClass="inventory-grid">
            <Columns>
                <DxGridSelectionColumn AllowSelectAll="false" Width="42px" />
                <DxGridDataColumn FieldName="@nameof(Product.Id)" Caption="#" Width="54px" AllowSort="false">
                    <CellDisplayTemplate Context="cell">
                        <span class="grid-row-number">@(cell.VisibleIndex + 1)</span>
                    </CellDisplayTemplate>
                    <FilterRowCellTemplate></FilterRowCellTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(Product.Sku)" Caption="SKU" Width="140px" />
                <DxGridDataColumn FieldName="@nameof(Product.Name)" Caption="Item name" MinWidth="190" />
                <DxGridDataColumn FieldName="@nameof(Product.Category)" Caption="Category" Width="160px" />
                <DxGridDataColumn FieldName="@nameof(Product.Quantity)" Caption="On hand" Width="110px" ReadOnly="true">
                    <CellDisplayTemplate Context="cell">
                        @if (cell.DataItem is Product item)
                        {
                            <span class="stock-value @(item.Quantity <= item.ReorderLevel ? "stock-low" : "stock-good")">@item.Quantity</span>
                        }
                    </CellDisplayTemplate>
                </DxGridDataColumn>
                <DxGridDataColumn FieldName="@nameof(Product.UnitPrice)" Caption="Unit cost" DisplayFormat="C2" Width="130px" />
                <DxGridDataColumn FieldName="@nameof(Product.ReorderLevel)" Caption="Reorder level" Width="135px" />
            </Columns>
        </DxGrid>
        @if (FilteredItems.Count == 0 && errorMessage is null)
        {
            <div class="empty-state">
                <strong>@(items.Count == 0 ? "No items yet" : "No matching items")</strong>
                <span>@(items.Count == 0 ? "Add an item to start managing inventory." : "Try a different column filter.")</span>
            </div>
        }
    </div>
</section>

@code {
    private DxGrid? grid;
    private List<Product> items = [];
    private IReadOnlyList<object> selectedDataItems = Array.Empty<object>();
    private GridEditNewRowPosition editNewRowPosition = GridEditNewRowPosition.Bottom;
    private int pageIndex;
    private List<Product> productsToDelete = [];
    private bool confirmDeleteVisible;
    private string? errorMessage;
    private string selectedFilterColumn = "All";
    private string columnFilterText = string.Empty;

    private List<Product> FilteredItems => items
        .Where(item => string.IsNullOrWhiteSpace(columnFilterText) || selectedFilterColumn switch
        {
            nameof(Product.Sku) => Matches(item.Sku),
            nameof(Product.Name) => Matches(item.Name),
            nameof(Product.Category) => Matches(item.Category),
            nameof(Product.Quantity) => Matches(item.Quantity.ToString()),
            nameof(Product.UnitPrice) => Matches(item.UnitPrice.ToString()),
            nameof(Product.ReorderLevel) => Matches(item.ReorderLevel.ToString()),
            _ => Matches(item.Sku) || Matches(item.Name) || Matches(item.Category) ||
                 Matches(item.Quantity.ToString()) || Matches(item.UnitPrice.ToString()) ||
                 Matches(item.ReorderLevel.ToString())
        })
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Busy.SetBusy(true);
        try
        {
            await Inventory.InitializeAsync();
            items = (await Inventory.GetProductsAsync()).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load the item master.");
            errorMessage = "Could not load items from SQL Server LocalDB.";
        }
        finally
        {
            Busy.SetBusy(false);
        }
    }

    private async Task AddItemAsync()
    {
        errorMessage = null;
        await StartNewRowAsync(GridEditNewRowPosition.Bottom);
    }

    private async Task InsertItemAsync()
    {
        errorMessage = null;
        await StartNewRowAsync(GridEditNewRowPosition.Top);
    }

    private async Task StartNewRowAsync(GridEditNewRowPosition position)
    {
        if (grid is null)
            return;

        editNewRowPosition = position;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await grid.StartEditNewRowAsync(nameof(Product.Name));
    }

    private static bool Matches(string value, string filter) =>
        value.Contains(filter, StringComparison.OrdinalIgnoreCase);

    private bool Matches(string value) => Matches(value, columnFilterText);

    private void DeleteSelectedItems()
    {
        productsToDelete = selectedDataItems.OfType<Product>().ToList();
        if (productsToDelete.Count > 0)
        {
            confirmDeleteVisible = true;
        }
    }

    private Task ResetGridAsync()
    {
        selectedFilterColumn = "All";
        columnFilterText = string.Empty;
        selectedDataItems = Array.Empty<object>();
        if (grid is not null)
        {
            grid.ClearFilter();
            grid.ClearSort();
            grid.ClearSelection();
            pageIndex = 0;
        }
        return Task.CompletedTask;
    }

    private Task CancelDeleteAsync()
    {
        confirmDeleteVisible = false;
        productsToDelete = [];
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (productsToDelete.Count == 0)
            return;

        var productIds = productsToDelete.Select(product => product.Id).ToArray();
        var count = productIds.Length;
        Busy.SetBusy(true);
        errorMessage = null;
        try
        {
            await Inventory.DeleteProductsAsync(productIds);
            items = (await Inventory.GetProductsAsync()).ToList();
            selectedDataItems = Array.Empty<object>();
            grid?.ClearSelection();
            Toasts.Show($"{count} item{(count == 1 ? "" : "s")} removed.", ToastKind.Info);
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to delete selected items.");
            errorMessage = "The item could not be deleted. Check the database connection and try again.";
        }
        finally
        {
            confirmDeleteVisible = false;
            productsToDelete = [];
            Busy.SetBusy(false);
        }
    }

    private void CustomizeEditModel(GridCustomizeEditModelEventArgs args)
    {
        if (args.IsNew)
        {
            var item = (Product)args.EditModel;
            item.Sku = $"ITEM-{Guid.NewGuid():N}"[..13].ToUpperInvariant();
            item.Name = "New item";
            item.Category = "General";
        }
    }

    private async Task SaveEditAsync(GridEditModelSavingEventArgs args)
    {
        var item = (Product)args.EditModel;
        Busy.SetBusy(true);
        errorMessage = null;
        try
        {
            await Inventory.SaveProductAsync(item);
            items = (await Inventory.GetProductsAsync()).ToList();
            args.Reload = true;
            Toasts.Show(args.IsNew ? "Item added." : "Item updated.");
        }
        catch (InvalidOperationException exception)
        {
            args.Cancel = true;
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            args.Cancel = true;
            Logger.LogError(exception, "Unable to save item {Sku}.", item.Sku);
            errorMessage = "The item could not be saved. Check the SKU and database connection.";
        }
        finally
        {
            Busy.SetBusy(false);
        }
    }

    private void DismissError() => errorMessage = null;
}

<ConfirmDialog Visible="@confirmDeleteVisible"
               Title="@($"Delete {productsToDelete.Count} item{(productsToDelete.Count == 1 ? "" : "s")}?")"
               Message="This action cannot be undone."
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />
