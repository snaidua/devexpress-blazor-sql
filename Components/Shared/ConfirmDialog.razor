@if (Visible)
{
    <div class="modal-backdrop" role="presentation" @onclick="Cancel">
        <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title" @onclick:stopPropagation="true">
            <span class="dialog-icon">!</span>
            <h2 id="confirm-title">@Title</h2>
            <p>@Message</p>
            <div class="dialog-actions">
                <button type="button" class="button button-quiet" @onclick="Cancel">Cancel</button>
                <button type="button" class="button button-danger" @onclick="OnConfirm">Confirm</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Are you sure?";
    [Parameter] public string Message { get; set; } = "This action cannot be undone.";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task Cancel() => OnCancel.InvokeAsync();
}
